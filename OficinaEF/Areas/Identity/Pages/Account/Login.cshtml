@page
@model LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<style>
    /* Fundo da tela mesclando os tons violeta e o brilho quente da foto */
    .lumina-login-wrapper {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: 
            radial-gradient(circle at 85% 15%, rgba(147, 51, 234, 0.2) 0%, transparent 45%),
            radial-gradient(circle at 15% 85%, rgba(245, 158, 11, 0.12) 0%, transparent 40%),
            linear-gradient(135deg, #f4f1fa 0%, #e9e4f5 100%);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        padding: 20px;
    }

    /* Card com borda e sombra integrada à paleta da foto */
    .lumina-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(35, 18, 75, 0.18), 
                    0 0 0 1px rgba(255, 255, 255, 0.8);
        width: 100%;
        max-width: 900px;
        min-height: 540px;
        display: flex;
        position: relative;
        overflow: hidden;
    }

    /* Formulário (Lado Esquerdo) */
    .lumina-form-container {
        flex: 1;
        padding: 50px 55px;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: 440px;
        background: #ffffff;
    }

    .brand-dot {
        width: 14px;
        height: 14px;
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        border-radius: 50%;
        margin-bottom: 25px;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
    }

    .brand-welcome {
        color: #8b88a5;
        font-size: 0.9rem;
        margin: 0;
        font-weight: 500;
    }

    .brand-title {
        color: #1f174a;
        font-size: 2rem;
        font-weight: 800;
        margin: 0 0 35px 0;
        letter-spacing: -0.5px;
    }

    .form-group-lumina {
        margin-bottom: 24px;
    }

    .form-group-lumina label {
        display: block;
        font-size: 0.8rem;
        color: #8b88a5;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .input-lumina {
        width: 100%;
        border: none;
        border-bottom: 1.5px solid #e2e0ed;
        padding: 8px 0;
        font-size: 0.95rem;
        color: #2b244d;
        background: transparent;
        outline: none;
        transition: border-color 0.25s ease;
    }

    .input-lumina:focus {
        border-bottom-color: #7c3aed;
    }

    .remember-container {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 25px;
    }

    .remember-container label {
        font-size: 0.82rem;
        color: #8b88a5;
        margin: 0;
        cursor: pointer;
    }

    .btn-lumina {
        background: linear-gradient(135deg, #a855f7 0%, #7c3aed 100%);
        color: #ffffff;
        border: none;
        border-radius: 25px;
        padding: 11px 36px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 6px 16px rgba(124, 58, 237, 0.35);
    }

    .btn-lumina:hover {
        background: linear-gradient(135deg, #9333ea 0%, #6d28d9 100%);
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.45);
    }

    .lumina-footer-links {
        margin-top: 32px;
        font-size: 0.82rem;
        color: #8b88a5;
    }

    .lumina-footer-links a {
        color: #7c3aed;
        text-decoration: none;
        font-weight: 600;
    }

    .lumina-footer-links a:hover {
        text-decoration: underline;
    }

    /* Container do Lado da Foto - Cor de fundo combinando exatamente com o tom da noite da imagem */
    .lumina-art-container {
        flex: 1.25;
        position: relative;
        overflow: hidden;
        background-color: #24144e;
    }

    .lumina-art-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center left;
        display: block;
    }

    @@media (max-width: 768px) {
        .lumina-card {
            flex-direction: column;
        }
        .lumina-art-container {
            display: none;
        }
        .lumina-form-container {
            max-width: 100%;
            padding: 35px 30px;
        }
    }
</style>

<div class="lumina-login-wrapper">
    <div class="lumina-card">
        
        <!-- Formulário de Login (Esquerda) -->
        <div class="lumina-form-container">
            <div class="brand-dot"></div>
            <p class="brand-welcome">Bem-vindo à</p>
            <h1 class="brand-title">Lumina Lar</h1>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="form-group-lumina">
                    <label asp-for="Input.Email">E-mail</label>
                    <input asp-for="Input.Email" class="input-lumina" autocomplete="username" aria-required="true" placeholder="bonjourguys@talk.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-group-lumina">
                    <label asp-for="Input.Password">Senha</label>
                    <input asp-for="Input.Password" type="password" class="input-lumina" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="remember-container">
                    <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" />
                    <label for="rememberMeCheck">Lembrar de mim</label>
                </div>

                <div>
                    <button id="login-submit" type="submit" class="btn-lumina">ENTRAR</button>
                </div>

                <div class="lumina-footer-links">
                    <p class="mb-2">
                        <a id="forgot-password" asp-page="./ForgotPassword">Esqueceu sua senha?</a>
                    </p>
                    <p class="mb-0">
                        Não tem uma conta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Cadastre-se</a>
                    </p>
                </div>
            </form>
        </div>

        <!-- Sua foto mantida exatamente do seu jeito -->
        <div class="lumina-art-container">
            <img src="~/imagens/images.jpg" alt="Ilustração Lumina Lar" class="lumina-art-image" />
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}